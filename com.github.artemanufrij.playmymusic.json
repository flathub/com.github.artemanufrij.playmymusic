{
    "app-id": "com.github.artemanufrij.playmymusic",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "base": "io.elementary.BaseApp",
    "base-version": "circe-25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/vala/bin/",
        "prepend-ld-library-path": "/usr/lib/sdk/vala/lib"
    },
    "command": "com.github.artemanufrij.playmymusic",
    "finish-args": [
        /* X11 + XShm */
        "--share=ipc",
        "--socket=x11",
        /* Wayland */
        "--socket=wayland",
        /* Filesystem */
        "--filesystem=host",
        "--talk-name=org.gtk.vfs.*",
        /* Network (Radio + Covers) */
        "--share=network",
        /* dconf */
        "--metadata=X-DConf=migrate-path=/com/github/artemanufrij/playmymusic/",
        /* Audio */
        "--socket=pulseaudio",
        /* Notifications */
        "--talk-name=org.freedesktop.Notifications",
        /* Inhibitor */
        "--talk-name=org.freedesktop.ScreenSaver",
        /* Media Keys */
        "--talk-name=org.mpris.MediaPlayer2",
        "--own-name=org.mpris.MediaPlayer2.com.github.artemanufrij.playmymusic"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/aclocal",
        "/man",
        "/share/man",
        "/share/gtk-doc",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/libsoup/libsoup-2.4.json",
        {
            "name": "libgee",
            "make-install-args": [
                "girdir=/app/share/gir-1.0",
                "typelibdir=/app/lib/girepository-1.0"
            ],
            "sources": [{
                "type": "archive",
                "url": "https://download.gnome.org/sources/libgee/0.20/libgee-0.20.8.tar.xz",
                "sha256": "189815ac143d89867193b0c52b7dc31f3aa108a15f04d6b5dca2b6adfad0b0ee"
            }]
        },
        {
            "name": "taglib",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [{
                "type": "archive",
                "url": "https://github.com/taglib/taglib/archive/v1.12.tar.gz",
                "sha256": "b5a56f78a8bd962aaaec992b25a031f541b949b6eb30aa232bd6d5fa17cf8fa8"
            }]
        },
        {
            "name": "playmymusic",
            "buildsystem": "meson",
            "build-options": {
                "config-opts": [
                    "--buildtype=release"
                ]
            },
            "sources": [{
                "type": "archive",
                "url": "https://github.com/artemanufrij/playmymusic/archive/2.2.1.tar.gz",
                "sha256": "a5ea467fc5ed65efe83a5b650019a2562618467c26fda5b0bec49b78b8fdbeb5"
            },{
                "type": "patch",
                "paths": [
                    "elementary-theme.patch",
                    "fix-appdata.patch",
                    "fix-quit-action.patch"
                ]}
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/scalable/apps",
                "mv /app/share/icons/hicolor/64x64/apps/${FLATPAK_ID}.svg /app/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
                "find /app/share/icons/hicolor -type f -not -path \"*scalable*\" -not -path \"*actions*\" -name \"*.svg\" -delete"
            ]
        }
    ]
}
