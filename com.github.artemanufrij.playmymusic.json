{
    "app-id": "com.github.artemanufrij.playmymusic",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "base": "io.elementary.BaseApp",
    "base-version": "circe-25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/vala/bin/",
        "prepend-ld-library-path": "/usr/lib/sdk/vala/lib"
    },
    "command": "com.github.artemanufrij.playmymusic",
    "finish-args": [
        /* X11 + XShm */
        "--share=ipc",
        "--socket=fallback-x11",
        /* Wayland */
        "--socket=wayland",
        /* Filesystem */
        "--filesystem=host",
        "--talk-name=org.gtk.vfs.*",
        /* Network (Radio + Covers) */
        "--share=network",
        /* dconf */
        "--metadata=X-DConf=migrate-path=/com/github/artemanufrij/playmymusic/",
        /* Audio */
        "--socket=pulseaudio",
        /* Notifications */
        "--talk-name=org.freedesktop.Notifications",
        /* Inhibitor */
        "--talk-name=org.freedesktop.ScreenSaver",
        /* Media Keys */
        "--talk-name=org.mpris.MediaPlayer2"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/aclocal",
        "/man",
        "/share/man",
        "/share/gtk-doc",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/libsoup/libsoup-2.4.json",
        {
            "name": "playmymusic",
            "buildsystem": "meson",
            "build-options": {
                "config-opts": [
                    "--buildtype=release"
                ]
            },
            "sources": [{
                "type": "archive",
                "url": "https://github.com/artemanufrij/playmymusic/archive/2.2.1.tar.gz",
                "sha256": "a5ea467fc5ed65efe83a5b650019a2562618467c26fda5b0bec49b78b8fdbeb5"
            },{
                "type": "patch",
                "paths": [
                    "elementary-theme.patch",
                    "fix-appdata.patch",
                    "fix-quit-action.patch"
                ]}
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/scalable/apps",
                "mv /app/share/icons/hicolor/64x64/apps/${FLATPAK_ID}.svg /app/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
                "find /app/share/icons/hicolor -type f -not -path \"*scalable*\" -not -path \"*actions*\" -name \"*.svg\" -delete"
            ]
        }
    ]
}
